{
  "appId": "local.paperreader.desktop",
  "productName": "Paper Reader",
  "asar": true,
  "directories": {
    "output": "../../work/electron-build"
  },
  "files": [
    "desktop.mjs",
    "desktop-setup.mjs",
    "onboarding.mjs",
    "managed-link.mjs",
    "plugins/paper-reader-link/credential-store.mjs",
    "plugins/paper-reader-link/launcher-instance.mjs",
    "setup.html",
    "setup.css",
    "setup.mjs",
    "desktop-profile.mjs",
    "desktop-preload.cjs",
    "chatgpt-panel.mjs",
    "web-panel-policy.mjs",
    "web-panel-send.mjs",
    "link-question.mjs",
    "server.mjs",
    "auth.mjs",
    "settings.mjs",
    "tokens.mjs",
    "context.mjs",
    "auto-context.mjs",
    "auto-budget.mjs",
    "chats.mjs",
    "annotations.mjs",
    "annotation-ui.mjs",
    "annotation-geometry.mjs",
    "reading-tools.mjs",
    "reading-state.mjs",
    "reading-restore.mjs",
    "annotation-overlay.css",
    "usage.mjs",
    "stream.mjs",
    "index.html",
    "app.mjs",
    "web-panel-ui.mjs",
    "help.mjs",
    "app.css",
    "ui.css",
    "notes.css",
    "auth-page.css",
    "markdown.bundle.mjs",
    "vendor/**/*",
    "pdfjs/**/*",
    "package.json",
    "!pdfjs/**/*.map",
    "paper-link.mjs",
    "pdf-evidence.mjs",
    "link-ui.mjs",
    "pdf-query-worker.mjs",
    "pdf-query.mjs",
    "pdf-text.mjs","pdf-passages.mjs","pdf-snapshots.mjs",
    "pdf-render-service.mjs",
    "pdf-render-recovery.mjs",
    "pdf-renderer.html",
    "pdf-renderer.mjs",
    "pdf-renderer-preload.cjs"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": false
  },
  "extraResources": [{"from":"build/link-payload","to":"paper-reader-link","filter":["**/*","!tools/tunnel-client.exe"]}],
  "afterPack": "./scripts/copy-desktop-tunnel.mjs",
  "portable": {
    "artifactName": "Paper-Reader-${version}-Windows-x64.exe"
  }
}
